# ── Java / Spring Boot ────────────────────────────────
target/
*.class
*.jar
*.war
*.nar
*.ear
!**/src/main/**/target/
!**/src/test/**/target/
.mvn/wrapper/maven-wrapper.jar
HELP.md
*.ctxt
.mtj.tmp/
hs_err_pid*
replay_pid*

# ── Python / AI Service ───────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
ai-service/.venv/
*.egg-info/
.pytest_cache/

# ── Modèles IA ────────────────────────────────────────
# Les modèles livrés vivent dans ai-service/model/ et sont versionnés.
# On ignore uniquement les modèles déposés ailleurs (entraînement local, etc.).
ai-service/app/model/*
!ai-service/app/model/.gitkeep
ai-service/*.keras
ai-service/*.h5
ai-service/*.pt
ai-service/*.pth
ai-service/*.pkl
ai-service/*.onnx
ai-service/*.pb

# ── Node / React ──────────────────────────────────────
node_modules/
dist/
build/
.npm/

